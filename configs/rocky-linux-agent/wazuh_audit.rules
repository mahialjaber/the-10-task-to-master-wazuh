# Linux Auditd Kernel Rules for Wazuh SIEM
# Author: Mahi Al Jaber (github.com/mahialjaber)
# Target Node: Rocky Linux 9.8 (rhel-endpoint-01)
# Location: /etc/audit/rules.d/wazuh_audit.rules

# Monitor sensitive identity and authentication files
-w /etc/passwd -p wa -k identity_changes
-w /etc/shadow -p wa -k identity_changes
-w /etc/group -p wa -k identity_changes
-w /etc/gshadow -p wa -k identity_changes
-w /etc/sudoers -p wa -k identity_changes
-w /etc/sudoers.d/ -p wa -k identity_changes

# Monitor process execution (execve system call on 64-bit architecture)
-a always,exit -F arch=b64 -S execve -k exec_commands
-a always,exit -F arch=b32 -S execve -k exec_commands

# Monitor network environment changes
-w /etc/hosts -p wa -k system_network_mods
-w /etc/resolv.conf -p wa -k system_network_mods
